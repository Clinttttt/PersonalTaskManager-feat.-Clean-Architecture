@page "/counter"
@rendermode InteractiveServer

<PageTitle>Counter</PageTitle>

<h1>Counter</h1>

<p role="status">Current count: @currentCount</p>

<button class="btn btn-primary" @onclick="IncrementCount">Click me</button>





<div class="flex">
    <!-- Sidebar -->
    <div class="@SidebarClass bg-base-200 h-50 transition-all duration-300 overflow-hidden">
        <h2 class="text-xl font-bold mb-4">Sidebar</h2>
        <ul class="menu">
            <li><a>Home</a></li>
            <li><a>Profile</a></li>
            <li><a>Settings</a></li>
        </ul>
    </div>

    <!-- Main Content -->
    <div class="flex-1 transition-all duration-300" style="@ContentStyle">
        <div class="navbar bg-base-100 w-13 shadow mb-4">
            <div class="flex-none">
                <button class="btn btn-square btn-ghost" @onclick="ToggleSidebar">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none"
                         viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round"
                              stroke-width="2"
                              d="M4 6h16M4 12h16M4 18h16" />
                    </svg>
                </button>
            </div>
         
        </div>

      
    </div>
</div>

@code {
    private bool isSidebarOpen = true;

    private string SidebarClass => isSidebarOpen ? "w-64" : "w-0";
    private string ContentStyle => isSidebarOpen ? "margin-left: 0;" : "margin-left: 0;";

    private void ToggleSidebar()
    {
        isSidebarOpen = !isSidebarOpen;
    }
}














@code {
    private int currentCount = 0;

    private void IncrementCount()
    {
        currentCount++;
    }
}
