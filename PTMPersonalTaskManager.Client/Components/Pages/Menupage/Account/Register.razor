@using PTMPersonalTaskManager.Client.Services
@using PTMPersonalTaskManager.Domain.DTOs
@using PTMPersonalTaskManager.Infrastructure.Services
@inject PageState pageState
@rendermode InteractiveServer
@attribute [StreamRendering]
@inject AuthApiServices authApiServices
@inject NavigationManager navigation

<EditForm Model="@User" OnValidSubmit="@Registers" FormName="registers">
<div class="relative px-4 pt-3 flex flex-col items-center gap-3">

    <!--image-->
    <div class="w-20 h-20 rounded-full overflow-hidden ">
        <img class="w-full h-full object-cover" src="/img/profile-icon.png" />
    </div>
    <h1 class="text-lg sm:text-2xl font-bold bg-gradient-to-t from-cyan-800 to-sky-900 bg-clip-text text-transparent">Register Account</h1>


    <!--Username-->

        <label class="input validator max-w-sm w-full h-8 rounded-lg text-sky-800 focus:outline-none " style="border:1px solid rgba(0,0,0,0.2)">
            <svg class="h-[1em] opacity-50" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
                <g stroke-linejoin="round"
                   stroke-linecap="round"
                   stroke-width="2.5"
                   fill="none"
                   stroke="currentColor">
                    <path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2"></path>
                    <circle cx="12" cy="7" r="4"></circle>
                </g>
            </svg>
            <input type="text"
                   required
                   @bind="User.UserName"
                   placeholder="Username"
                   pattern="[A-Za-z][A-Za-z0-9\-]*"
                   minlength="3"
                   maxlength="30"
                   title="Only letters, numbers or dash" />
        </label>
        <!--Password-->
        <label class="input validator h-8 max-w-sm w-full h-8 rounded-lg text-sky-800 focus:outline-none " style="border:1px solid rgba(0,0,0,0.2)">
            <svg class="h-[1em] opacity-50" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
                <g stroke-linejoin="round"
                   stroke-linecap="round"
                   stroke-width="2.5"
                   fill="none"
                   stroke="currentColor">
                    <path d="M2.586 17.414A2 2 0 0 0 2 18.828V21a1 1 0 0 0 1 1h3a1 1 0 0 0 1-1v-1a1 1 0 0 1 1-1h1a1 1 0 0 0 1-1v-1a1 1 0 0 1 1-1h.172a2 2 0 0 0 1.414-.586l.814-.814a6.5 6.5 0 1 0-4-4z"></path>
                    <circle cx="16.5" cy="7.5" r=".5" fill="currentColor"></circle>
                </g>
            </svg>
            <input type="password"
                   required
                   @bind="User.Password"
                   placeholder="Password"
                   minlength="8" />

        </label>
        <label class="input validator h-8 max-w-sm w-full h-8 rounded-lg text-sky-800 focus:outline-none " style="border:1px solid rgba(0,0,0,0.2)">
            <svg class="h-[1em] opacity-50" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
                <g stroke-linejoin="round"
                   stroke-linecap="round"
                   stroke-width="2.5"
                   fill="none"
                   stroke="currentColor">
                    <path d="M2.586 17.414A2 2 0 0 0 2 18.828V21a1 1 0 0 0 1 1h3a1 1 0 0 0 1-1v-1a1 1 0 0 1 1-1h1a1 1 0 0 0 1-1v-1a1 1 0 0 1 1-1h.172a2 2 0 0 0 1.414-.586l.814-.814a6.5 6.5 0 1 0-4-4z"></path>
                    <circle cx="16.5" cy="7.5" r=".5" fill="currentColor"></circle>
                </g>
            </svg>
            <input type="password"
                   required
                   @bind="ConfirmPassword"
                   placeholder="Re Enter Password"
                   minlength="8" />

        </label>


    <button type="submit" class="btn-wide btn  bg-gradient-to-t from-teal-400 to-cyan-500 text-cyan-100 rounded-md">Register</button>

</div>
</EditForm>
@if (!string.IsNullOrEmpty(Error))
{
    <h1 class="text-red-600">@Error</h1>
}

@code {
    private UserDto User = new();
    private string ConfirmPassword = string.Empty;
    public string? Error;



    private async Task Registers()
    {
        if(User.Password != ConfirmPassword)
        {
            Error = "Password not Match";
            return;
        }

        var register = await authApiServices.RegisterAsync(User);
        if (register is null)
        {
            Error = "User Already Exists";
        }
        else
        {
            pageState.ViewAccount(PageState.Account.Login);
        }
    }



}
