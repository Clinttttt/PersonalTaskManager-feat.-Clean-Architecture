@using PTMPersonalTaskManager.Client.Services
@inject PageState pageState


<div class="top-50 xs:top-40 absolute left-1/2 border-sky-300 rounded-sm bg-gradient-to-t from-cyan-100 to-cyan-50 custom-css h-85  top-40 -translate-x-[50%] sm:-translate-x-[50%] w-[100%] md:w-[50%]" style="border:solid 1px rgba(0,0,0,0.2)">
    @if (!hidelogin)
    {
        <Login />
    }
    else if (hidelogin)
    {
        <Register />
    }
</div>





@code{
    private bool hidelogin => pageState.Login;

    private void Reset()
    {
        pageState.Reset();
    }
    protected override void OnInitialized()
    {
        pageState.OnChange += StateHasChanged;
    }
    public void Dispose()
    {
        pageState.OnChange -= StateHasChanged;
    }
   

}