@code {
    private CreateTaskDto createTask = new();
    private string? Error;
    private DetailsDto? TaskDisplay { get; set; }
    private IEnumerable<DetailsDto>? display;



    private bool ShowNoteCard = true;
    private bool displaynotes = false;
    private void Hide()
    {
        ShowNoteCard = false;
        displaynotes = true;
        StateHasChanged();

    }
    private void SelectedTask(DetailsDto task)
    {
        TaskDisplay = task;
        Hide();
    }
    
  





    private async Task CreateTaskHandle()
    {
        Error = null;

        if (string.IsNullOrEmpty(createTask.Title) || string.IsNullOrEmpty(createTask.Description))
        {
            Error = "Fill up First";
        }
        try
        {

            var Create = await taskApiServices.CreateTaskAsync(createTask);


            if (Create is null)
            {
                Error = "Something Went Wrong";
                return;
            }

            var task = (await taskApiServices.AllTaskAsync())?.ToList() ?? new();
            await taskStateService.CreateTask(task);
            createTask = new();

        }

        catch (Exception ex)
        {
            System.Console.WriteLine("Error" + ex.Message);
        }

    }


    protected override void OnInitialized()
    {
        taskStateService.Onchange += Refresh;
        pageState.OnChange += StateHasChanged;
    }
    public async Task Refresh()
    {
        await InvokeAsync(StateHasChanged);
    }
    public void Dispose()
    {
        pageState.OnChange -= StateHasChanged;
    }


    protected override async Task OnInitializedAsync()
    {


        var task = (await taskApiServices.AllTaskAsync())?.ToList() ?? new();
        await taskStateService.CreateTask(task);

    }
}