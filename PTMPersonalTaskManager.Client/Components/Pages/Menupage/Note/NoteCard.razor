@code {
    private bool hidecard => pageState.HideCard;

    private void ShowByDefault()
    {
        pageState.Reset();
    }
    private void Hides() { ShowByDefault(); pageState.Hide(); }
    protected override void OnInitialized()
    {

        pageState.OnChange += StateHasChanged;
    }
    public void Dispose()
    {
        pageState.OnChange -= StateHasChanged;
    }

}
