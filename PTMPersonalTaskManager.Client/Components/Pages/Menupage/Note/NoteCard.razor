@using PTMPersonalTaskManager.Client.Services
@using PTMPersonalTaskManager.Domain.DTOs.DetailsDto
@using PTMPersonalTaskManager.Infrastructure.Services
@inject PageState pageState
@inject TaskApiServices taskApiServices
<div class="h-[565px] md:h-[275px]  absolute top-20 pb-4 flex gap-4 flex-row flex-wrap w-full  justify-center overflow-auto ">
    @if(display is null)
    {
        <h1>No Task</h1>
    }
    else
    {
        @foreach (var card in display)
        {
            <div class="  card  bg-gradient-to-b from-sky-400 h-[70%] to-cyan-700 text-primary-content w-[45%]">
                <div class="card-body">
                    <div class="h-[295px] md:h-[100px] overflow-auto relative">
                        <h2 class="card-title text-sky-200 text-lg ">@card.Title</h2>
                        <p class="text-sky-200 ">@card.Description</p>
                    </div>
                    <div class="card-actions justify-end absolute bottom-4 right-5">
                        <button @onclick="()=> Hides()" class="text-cyan-800 btn rounded-sm bg-gradient-to-b from-cyan-200 to-teal-200">View Tasks</button>
                    </div>
                </div>
            </div>


        }
    }








</div>


@code {
    private IEnumerable<DetailsDto>? display;

    protected override async Task OnInitializedAsync()
    {
        await HandleDisplayCard();
        StateHasChanged();
    } 
    private async Task HandleDisplayCard()
    {
        display = await taskApiServices.AllTaskAsync();
        
    }



    private bool hidecard => pageState.HideCard;

    private void ShowByDefault()
    {
        pageState.Reset();
    }
    private void Hides() { ShowByDefault(); pageState.Hide(); }
    protected override void OnInitialized()
    {

        pageState.OnChange += StateHasChanged;
    }
    public void Dispose()
    {
        pageState.OnChange -= StateHasChanged;
    }

}
