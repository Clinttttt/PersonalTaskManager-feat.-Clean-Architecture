@using Microsoft.AspNetCore.Components.Authorization
@using PTMPersonalTaskManager.Domain.DTOs.DetailsDto
@using PTMPersonalTaskManager.Infrastructure.Services
@inject TaskApiServices taskApiServices
@rendermode InteractiveServer
@attribute [StreamRendering]


    <div class="h-[695px] sm:h-[565px] relative h-[565px] md:h-[275px] absolute top-20 pb-4 flex gap-4 flex-row flex-wrap w-full   overflow-auto ">
   <CascadingAuthenticationState>
      <AuthorizeView>
          <Authorized>
                @if (Display is not null)
                {
                    <kbd class="kbd right-52 top-1 absolute text-cyan-800 bg-gradient-to-t from-sky-100 to-cyan-100 rounded-sm">@Display.Priority</kbd>
                    <p class="right-5 top-1 absolute bg-gradient-to-t from-teal-900 to-sky-900 bg-clip-text text-transparent"> @Display.DueDate</p>
                    <button type="submit" class=" btn right-24 top-10 absolute bg-gradient-to-t from-teal-400 to-cyan-500 text-cyan-100 rounded-md">Modify</button>
                    <input type="checkbox" aria-label="Ended" class=" btn right-5 top-10 absolute bg-gradient-to-t from-green-400 to-emerald-500 text-cyan-100 rounded-md" style="border-bottom: solid 1px rgba(0, 177, 191)" />

                    <h1 class="inline-block max-w-[90%] mt-27 ml-7 text-lg break-words italic font-semibold bg-gradient-to-t from-cyan-900 to-sky-900 bg-clip-text text-transparent">@Display.Title </h1>


                    <div class="flex  justify-center h-[440px] w-[95%] ml-3 overflow-auto">
                        <p class="text-justify font-semilight bg-gradient-to-t from-cyan-800 to-sky-900 bg-clip-text text-transparent indent-6">
                            @Display.Description
                        </p>
                    </div>

                }
                else
                {

                    <h1 class="text-ref-500">@Error</h1>

                }
            </Authorized>
            <NotAuthorized>
                <h1>Not Login</h1>
            </NotAuthorized>
        </AuthorizeView>
    </CascadingAuthenticationState>
</div>


@code {
    [Parameter]
    public DetailsDto Item { get; set; } = default!;


    
    public DetailsDto? Display;
    public string? Error;
    protected override async Task OnParametersSetAsync()
    {
        Display = await taskApiServices.GetDataAsync(Item.Id);
        if(Display is null)
        {
            Error = "Nothing to Displays";
         
        }
    }
}
