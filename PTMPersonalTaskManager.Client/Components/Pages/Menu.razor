                        </svg>

                    </button>
                </div>

            </div>


        </div>
    </div>




    <!--chat-->
    <div class="hidden md:block top-40 left-0 93 md:h-89 border absolute w-[23%] h-80 border-sky-400 bg-gradient-to-t from-cyan-600 to-sky-300 rounded-sm ">
        <div class="chat chat-start">
            <div class="chat-image avatar">
                <div class="w-10 rounded-full">
                    <img alt="Tailwind CSS chat bubble component"
                         src="/img/liama2.png" />
                </div>
            </div>
            <div class="chat-header text-sky-800">
                liama
                <time class="text-xs opacity-50">12:45</time>
            </div>
            <div class="chat-bubble bg-sky-100 text-cyan-800 text-sm">You were the Chosen One!</div>
            <div class="chat-footer opacity-50">Delivered</div>
        </div>
        <div class="chat chat-end ">
            <div class="chat-image avatar ">
                <div class="w-10 rounded-full mr-1 ">
                    <img alt="Tailwind CSS chat bubble component"
                         src="/img/clint.jpg" />
                </div>
            </div>
            <div class="chat-header text-sky-800">
                Clint
                <time class="text-xs opacity-50">12:46</time>
            </div>
            <div class="chat-bubble bg-sky-100 text-cyan-800 text-sm">I hate you!</div>
            <div class="chat-footer opacity-50">Seen at 12:46</div>
        </div>
