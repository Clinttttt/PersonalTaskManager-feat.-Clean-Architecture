    <!--  <div class="w-76 h-83 mt-16 self-center bg-base-300" style="border:solid 1px rgba(0,0,0,0.2)">


      </div>-->



    <div class="h-40 gap-1 flex flex-wrap xs:h-30 flex flex-wrap items-center justify-center  w-149 md:h-30   rounded-b-lg mt-5 border bg-linear-to-t from-cyan-500 to-blue-500 text-white  " style="border: solid 1px rgba(0,0,0,0.2)">
        <img @onclick="()=> showHome()" class="icon-hover " src="img/home-icon.png" alt="home icon" width="62" height="62" />
        <img @onclick="()=> showProfile()" class=" hidden sm:block icon-hover" src="img/profile-icon.png" alt="Profile icon" width="62" height="62" />
        <img @onclick="()=> showCalendar()" class=" icon-hover " src="img/calendar-icon.png" alt="Calendar Icon" width="62" height="62" />
        <img @onclick="()=> priority()" class="icon-hover" src="img/priority-task.png" alt="priority Task" width="62" height="62" />
        <img @onclick="()=> completed()" class="icon-hover" src="img/complete-icon.png" alt="complete Task" width="62" height="62" />
        <img @onclick="()=> note()" class="icon-hover" src="img/note-icon.png" alt="note" width="62" height="62" />
        <img @onclick="()=> showCard()" class=" icon-hover" src="img/card-icon.png" alt="card" width="62" height="62" />
        <img @onclick="()=> search()" class="hidden sm:block icon-hover" src="img/search-icon.png" alt="search task " width="62" height="62" />
        <img @onclick="()=> dashboard()" class="icon-hover" src="img/dashboard-icon.png" alt="dashboard " width="62" height="62" />
    </div>





    <!--
        <div class="w-60 h-118 mb-19 self-center bg-base-300 -translate-x-[1%]">
        </div>
    -->
    <!--Core-->
   @if (ShowCalendar)
    {
        <CalendarPage />

    }
    else if (ShowProfile)
    {
        <ProfilePage/>
    }
    else if (ShowCard)
    {
        <CardPage/>
    }
    else if (ShowHome)
    {
        <HomePagerazor/>
    }
    else if (ShowPriority)
    {
        <PriorityPage />
    }
    else if (ShowCompleted)
    {
        <CompletedPage />
    }
    else if (ShowNote)
    {
        <NotePage />
    }
    else if (ShowSearh)
    {
        <SearchPage />
    }
    else if (ShowDashboard)
    {
        <DashBoardPage />
    }
</div>









@code {
    private bool isSidebarOpen = true;
    private bool ShowProfile => pageState.ShowProfile;
    private bool ShowCalendar = false;
    private bool ShowCard = false;
    private bool ShowHome = false;
    private bool ShowPriority = false;
    private bool ShowCompleted = false;
    private bool ShowNote = false;
    private bool ShowSearh = false;
    private bool ShowDashboard = false;


    private string SidebarClass => isSidebarOpen ? "w-64" : "w-0";
    private string ContentStyle => isSidebarOpen ? "margin-left: 0;" : "margin-left: 0;";

    private void ToggleSidebar()
    {
        isSidebarOpen = !isSidebarOpen;
    }

    private void ResetPages()
    {
        ShowCalendar = false;
        //ShowProfile = false;
        ShowCard = false;
        ShowHome = false;
        ShowPriority = false;
        ShowCompleted = false;
        ShowNote = false;
        ShowSearh = false;
        ShowDashboard = false;
        pageState.Reset();
    }

    private void showCalendar() { ResetPages(); ShowCalendar = true; }
    private void showProfile() { ResetPages(); pageState.Show(); }
    private void showCard() { ResetPages(); ShowCard = true; }
    private void showHome() { ResetPages(); ShowHome = true; }
    private void priority() { ResetPages(); ShowPriority = true; }
    private void completed() { ResetPages(); ShowCompleted = true; }
    private void note() { ResetPages(); ShowNote = true; }
    private void search() { ResetPages(); ShowSearh = true; }
    private void dashboard() { ResetPages(); ShowDashboard = true; }

    protected override void OnInitialized()
    {

        pageState.OnChange += StateHasChanged;
    }
    public void Dispose()
    {
        pageState.OnChange -= StateHasChanged;
    }
      
    }
}


   