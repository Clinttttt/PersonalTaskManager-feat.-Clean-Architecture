                       class="custom-placeholder text-md bg-gradient-to-b from-sky-100 to-cyan-100  border-sky-300 w-full h-11 pr-24 border focus:ring-2 focus:outline-none focus:ring-cyan-500 rounded-xl pl-2   " />


                <button class="bg-gradient-to-t from-teal-300 to-cyan-300 border-sky-300 absolute top-1/2 -translate-y-1/2 right-1 h-8 px-4 text-sm bg-primary text-white rounded-md">
                    Send
                </button>
            </div>

        </div>
    </div>





