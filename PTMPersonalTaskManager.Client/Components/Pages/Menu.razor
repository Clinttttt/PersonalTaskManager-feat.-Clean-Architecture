        </div>-->

    <!--Core-->
  
        @if (pageState.CurrentView == PageState.PageView.CalendarPage)
        {
            <CalendarPage />

        }
        else if (pageState.CurrentView == PageState.PageView.ProfilePage)
        {
            <ProfilePage />
        }
        else if (pageState.CurrentView == PageState.PageView.Card)
        {
            <CardPage />
        }
        else if (pageState.CurrentView == PageState.PageView.HomePage)
        {
            <HomePagerazor />
        }
        else if (pageState.CurrentView == PageState.PageView.PriorityPage)
        {
            <AIChat />
        }
        else if (pageState.CurrentView == PageState.PageView.CompletedPage)
        {
            <CompletedPage />
        }
        else if (pageState.CurrentView == PageState.PageView.Note)
        {
            <NotePage />
        }
        else if (pageState.CurrentView == PageState.PageView.SearchPage)
        {
            <SearchPage />
        }
        else if (pageState.CurrentView == PageState.PageView.Account)
        {
            <Account />
        }
        else if (pageState.CurrentView == PageState.PageView.NoteCardDisplay)
        {
            <NotePage @key="pageState.RenderKey" />
        }

  

</div>










@code {

    private bool isSidebarOpen = false;



    private string SidebarClass => isSidebarOpen ? "w-64" : "w-0";
    private string ContentStyle => isSidebarOpen ? "margin-left: 0;" : "margin-left: 0;";

    private void ToggleSidebar()
    {
        isSidebarOpen = !isSidebarOpen;
    }



    protected override void OnInitialized()
    {
        pageState.Onchanges += Refresh;
        pageState.OnChange += StateHasChanged;
    }
    public void Dispose()
    {

        pageState.OnChange -= StateHasChanged;
        pageState.Onchanges -= Refresh;
    }


        private async Task Refresh()
        { 
        Console.WriteLine("Refresh called");
            await InvokeAsync(StateHasChanged);
        }

       
    
    




}



